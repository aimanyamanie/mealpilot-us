# Copy to .env and fill in. .env is gitignored; never commit real values.

# Neon Postgres, US East region. Use the pooled connection string.
DATABASE_URL=

# YouTube Data API v3 key (Google Cloud console). Embeds and video metadata only;
# never recipe data (see CLAUDE.md, Recipe sourcing)
YOUTUBE_API_KEY=

# USDA FoodData Central API key (https://fdc.nal.usda.gov/api-key-signup)
FDC_API_KEY=
